{
  "name": "claymo",
  "version": "1.0.0",
  "private": true,
  "description": "ClayMo Monorepo - 知识管理与效率工具平台",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter claymo-web dev",
    "dev:admin": "pnpm --filter claymo-admin dev",
    "build": "pnpm --filter claymo-web build",
    "build:admin": "pnpm --filter claymo-admin build",
    "build:packages": "pnpm --filter \"@claymo/*\" build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r exec rm -rf node_modules dist .turbo",
    "prepare": "pnpm build:packages"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.11.25",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.2.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "sass": "^1.71.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.1.6",
    "vite-plugin-compression": "^0.5.1",
    "vue-tsc": "^2.0.6"
  },
  "keywords": [
    "claymo",
    "knowledge-base",
    "productivity",
    "monorepo"
  ],
  "license": "MIT"
}
