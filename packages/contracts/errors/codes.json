        "UserDisabled": { "message": "用户已被禁用", "httpStatus": 403 },
        "UserLocked": { "message": "用户已被锁定，请稍后再试", "httpStatus": 423 },
        "InvalidCredentials": { "message": "用户名或密码错误", "httpStatus": 401 },
        "PasswordExpired": { "message": "密码已过期，请修改密码", "httpStatus": 403 },
        "InvalidPassword": { "message": "密码不符合要求", "httpStatus": 400 },
        "InvalidUserName": { "message": "用户名不符合要求", "httpStatus": 400 },
        "UserAlreadyExists": { "message": "用户名已存在", "httpStatus": 409 },
        "EmailAlreadyExists": { "message": "邮箱已被使用", "httpStatus": 409 },
