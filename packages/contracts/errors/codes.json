        "AccessDenied": { "message": "访问被拒绝", "httpStatus": 403 },
        "InsufficientPermissions": { "message": "权限不足", "httpStatus": 403 }
      }
    },
    "Tenant": {
      "name": "租户相关",
      "codes": {
        "NotFound": { "message": "租户不存在", "httpStatus": 404 },
