{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SqlSugar": {
    "DefaultConnectionName": "Default",
    "ConnectionStrings": {
      "Default": "Server=localhost;Port=3306;Database=claymo_host;Uid=root;Password=your_password_here"
    },
    "DbTypes": {
      "Default": "Mysql"
    }
  },
  "FileService": {
    "HuaWeiYun": {
      "BucketName": "your-bucket-name",
      "AccessKeyId": "YOUR_HUAWEI_ACCESS_KEY_ID",
      "SecretAccessKey": "YOUR_HUAWEI_SECRET_ACCESS_KEY",
      "EndPoint": "https://obs.cn-south-1.myhuaweicloud.com",
      "WorkingDir": "files/",
      "UrlRoot": "https://"
    },
    "SMS": {
      "WorkingDir": "sms/"
    }
  },
  "AliYunOptions": {
    "AccessKeyId": "YOUR_ALIYUN_ACCESS_KEY_ID",
    "AccessKeySecret": "YOUR_ALIYUN_ACCESS_KEY_SECRET",
    "EndPoint": "dysmsapi.aliyuncs.com",
    "Sms": {
      "SignName": "阿里云通信",
      "TemplateCode": "SMS_XXXXXXX"
    }
  },
  "SendCloudOptions": {
    "ApiUser": "YOUR_SENDCLOUD_API_USER",
    "ApiKey": "YOUR_SENDCLOUD_API_KEY",
    "From": "noreply@yourdomain.com"
  },
  "Redis": {
    "IsEnabled": true,
    "Configuration": "localhost:6379,password=your_redis_password",
    "JobDb": 1
  },
  "AbpDistributedCacheOptions": {
    "KeyPrefix": "ClayMo:"
  },
  "Jwt": {
    "Issuer": "ClayMo",
    "Audience": "ClayMo",
    "SecretKey": "YourSuperSecretKeyAtLeast32CharactersLong!",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "Hangfire": {
    "JobTimeoutHours": 1,
    "JobExpirationTimeoutHours": 24,
    "RedisPrefix": "ClayMo:HangfireJob:",
    "AllowMemoryStorage": false,
    "Dashboard": {
      "RequiredPermissionCode": "system.hangfire.dashboard",
      "AllowedCidrs": [],
      "AuthenticationScheme": null,
      "ReadOnly": false,
      "SkipAuthInDevelopment": false,
      "UserIdClaimTypes": ["sub", "user_id", "userid", "uid"]
    },
    "UnitOfWork": {
      "IsTransactional": true,
      "RequiresNew": true,
      "Timeout": null,
      "IsolationLevel": null
    }
  },
  "RateLimiting": {
    "IsEnabled": true,
    "PermitLimit": 1000,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6
  }
}
