{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Yarp": "Debug"
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:5080",
      "https://localhost:5443",
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api-service": {
            "Address": "http://localhost:19001"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file-service": {
            "Address": "http://localhost:8889"
          }
        }
      }
    }
  }
}

