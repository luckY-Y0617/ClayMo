{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Domains": {
    "AdminPrefix": "admin."
  },
  "Cors": {
    "Origins": [
      "*"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Forwarded-Proto", "Set": "https" }
        ]
      },
      "file-route": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/fs/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/fs" }
        ]
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api-service": {
            "Address": "http://api:19001"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file-service": {
            "Address": "http://file-service:8889"
          }
        }
      }
    }
  }
}


