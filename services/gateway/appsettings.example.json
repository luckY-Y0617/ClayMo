{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Domains": {
    "AdminPrefix": "admin."
  },
  "Cors": {
    "Origins": [
      "https://www.example.com",
      "https://admin.example.com"
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:5443",
        "Certificate": {
          "Path": "${SSL_CERT_PATH}",
          "KeyPath": "${SSL_KEY_PATH}"
        }
      },
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Forwarded-Proto", "Set": "https" }
        ]
      },
      "file-route": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/fs/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/fs" }
        ]
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api-service": {
            "Address": "${API_SERVICE_ADDRESS}"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file-service": {
            "Address": "${FILE_SERVICE_ADDRESS}"
          }
        }
      }
    }
  }
}
