# ================================================
# File Service 配置文件示例
# ================================================
# 使用说明：
# 1. 生产环境：此文件会在 Docker 构建时复制到镜像中作为默认配置
# 2. 开发环境：复制此文件为 file-api.yaml 并修改为本地配置
#    cp file-api.yaml.example file-api.yaml
# 3. 自定义配置：在服务器上创建 file-api.yaml 并挂载到容器
# ================================================

Name: file-service
Host: 0.0.0.0
Port: 8889

Auth:
  AccessSecret: "your-jwt-secret-key-at-least-32-characters-long"
  AccessExpire: 7200

DB:
  # Docker Compose 环境使用容器服务名，本地开发使用 localhost
  DataSource: "root:your_password@tcp(mysql:3306)/claymo_host?charset=utf8mb4&parseTime=true&loc=Local"

Redis:
  Host: "redis:6379"
  Type: "node"
  Pass: ""

Cache:
  - Host: "redis:6379"
    Type: "node"
    Pass: ""

Storage:
  Provider: "obs"  # 支持 "obs" (华为云) 或 "s3" (AWS S3/MinIO)
  Region: "cn-east-3"
  Endpoint: "obs.cn-east-3.myhuaweicloud.com"
  AccessKey: "YOUR_ACCESS_KEY_HERE"
  SecretKey: "YOUR_SECRET_KEY_HERE"
  Bucket: "your-bucket-name"
  UsePathStyle: true
  PresignPutExpireSeconds: 900
  PresignGetExpireSeconds: 300

UploadPolicy:
  AutoMultipartThresholdBytes: 10485760  # 10MB
  MinPartSizeBytes: 5242880              # 5MB
  MaxParts: 10000

Internal:
  HmacSecret: "CHANGE_ME_INTERNAL_HMAC_SECRET"
  AllowClockSkewSeconds: 60

Kafka:
  Brokers:
    - "kafka:9092"
  TopicTranscode: "file-transcode-tasks"
  TopicOutbox: "file-outbox-events"

# CORS 配置（生产环境可通过卷挂载覆盖此配置）
CORS:
  AllowedOrigins:
    - "*"
  AllowedMethods:
    - GET
    - POST
    - PUT
    - DELETE
    - OPTIONS
  AllowedHeaders:
    - Content-Type
    - Authorization
    - __tenant
    - X-Upload-Token
