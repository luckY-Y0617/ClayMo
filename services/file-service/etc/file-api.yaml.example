Name: file-service
Host: 0.0.0.0
Port: 8889

Auth:
  AccessSecret: "your-jwt-secret-key-at-least-32-characters-long"
  AccessExpire: 7200

DB:
  DataSource: "root:your_password@tcp(localhost:3306)/claymo_host?charset=utf8mb4&parseTime=true&loc=Local"

Redis:
  Host: "127.0.0.1:6379"
  Type: "node"
  Pass: ""

Cache:
  - Host: "127.0.0.1:6379"
    Type: "node"
    Pass: ""

Storage:
  Provider: "obs"  # 支持 "obs" (华为云) 或 "s3" (AWS S3/MinIO)
  Region: "cn-east-3"
  Endpoint: "obs.cn-east-3.myhuaweicloud.com"
  AccessKey: "YOUR_ACCESS_KEY_HERE"
  SecretKey: "YOUR_SECRET_KEY_HERE"
  Bucket: "your-bucket-name"
  UsePathStyle: true
  PresignPutExpireSeconds: 900
  PresignGetExpireSeconds: 300

UploadPolicy:
  AutoMultipartThresholdBytes: 10485760  # 10MB
  MinPartSizeBytes: 5242880              # 5MB
  MaxParts: 10000

Internal:
  HmacSecret: "CHANGE_ME_INTERNAL_HMAC_SECRET"
  AllowClockSkewSeconds: 60

Kafka:
  Brokers:
    - "127.0.0.1:19092"
  TopicTranscode: "file-transcode-tasks"
  TopicOutbox: "file-outbox-events"

# CORS配置（生产环境）
CORS:
  AllowedOrigins:
    - http://localhost:3000
    - https://yourdomain.com
    - https://admin.yourdomain.com
  AllowedMethods:
    - GET
    - POST
    - PUT
    - DELETE
    - OPTIONS
  AllowedHeaders:
    - Content-Type
    - Authorization
    - __tenant
    - X-Upload-Token
