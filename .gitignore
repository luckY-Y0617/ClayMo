# 在 .gitignore 中添加例外规则
!frontend/web/.env
!frontend/admin/.env

# appsettings.json 配置文件
# 允许标准环境配置文件（使用环境变量占位符）
!**/appsettings.json
!**/appsettings.Development.json
!**/appsettings.Production.json
!**/appsettings.example.json
# 只忽略本地覆盖文件（包含真实敏感信息）
**/appsettings.Local.json
**/appsettings.*.local.json


