# ================================================
# ClayMo 生产环境配置示例
# ================================================
# 使用方法：
#   1. 复制此文件为 .env（在项目根目录）
#   2. 根据实际情况修改配置
#   3. 重启服务：docker compose --profile full up -d
# ================================================

# ========================================
# 基础配置
# ========================================
ASPNETCORE_ENVIRONMENT=Production

# ========================================
# 数据库配置
# ========================================
MYSQL_ROOT_PASSWORD=YourStrongPassword123!
MYSQL_DATABASE=claymo_host

# Redis 密码（可选）
REDIS_PASSWORD=

# ========================================
# JWT 密钥（必须修改！）
# ========================================
JWT_SECRET_KEY=YourProductionJwtSecretKeyAtLeast32Chars!

# ========================================
# 场景 1：使用 IP 访问（当前阶段 - 推荐）
# ========================================
# 仅使用 HTTP，不需要证书
ASPNETCORE_URLS=http://+:5080
CORS_ORIGIN_0=*
# 证书配置留空
CERT_FILE=
CERT_KEY_FILE=
HTTPS_URL=

# ========================================
# 场景 2：使用域名 + HTTP（有域名但还没配置证书）
# ========================================
# ASPNETCORE_URLS=http://+:5080
# CORS_ORIGIN_0=http://yourdomain.com
# CORS_ORIGIN_1=http://admin.yourdomain.com
# CERT_FILE=
# CERT_KEY_FILE=
# HTTPS_URL=

# ========================================
# 场景 3：使用域名 + HTTPS（完整生产环境）
# ========================================
# ASPNETCORE_URLS=http://+:5080;https://+:5443
# CORS_ORIGIN_0=https://yourdomain.com
# CORS_ORIGIN_1=https://admin.yourdomain.com
# HTTPS_URL=https://+:5443
# CERT_FILE=/app/cert/yourdomain.com.pem
# CERT_KEY_FILE=/app/cert/yourdomain.com-key.pem
# CERT_PATH=/path/to/your/certs

# ========================================
# 文件服务配置（可选 - 使用云存储）
# ========================================
# 华为云 OBS
FILE_SERVICE_ENDPOINT=
FILE_SERVICE_ACCESS_KEY=
FILE_SERVICE_SECRET_KEY=
FILE_SERVICE_BUCKET=

# ========================================
# 其他配置
# ========================================
ADMIN_PREFIX=admin.

